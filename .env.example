# Sanity — from https://sanity.io/manage after `npx sanity init`
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-19

# Server-only. A Viewer token, needed for draft mode and live preview.
# Never prefix this with NEXT_PUBLIC_ — that would ship it to the browser.
SANITY_API_READ_TOKEN=

# Used by proxy.ts before any Sanity call can happen, so it must be static.
NEXT_PUBLIC_DEFAULT_LOCALE=en-IN

# Absolute URL, for canonical links, OG images, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
